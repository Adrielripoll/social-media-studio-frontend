{
  "name": "serga-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:media": "node --test scripts/media-refresh.test.ts",
    "test:playback": "node --test scripts/video-playback.test.ts",
    "test:quality": "node --test scripts/ui-quality.test.ts scripts/media-refresh.test.ts scripts/video-playback.test.ts",
    "test:ui-review": "playwright test --config playwright.review.config.ts tests/ui-quality.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "chart.js": "4.5.1",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
